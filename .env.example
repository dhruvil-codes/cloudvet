# Set these in your shell or secret manager. cloudvet does not auto-load .env files.
GMI_AGENTBOX_API_KEY=
GMI_MAAS_API_KEY=
GMI_MAAS_BASE_URL=https://api.gmi-serving.com/v1
GMI_DEFAULT_IDC=us-central-iowa16
GMI_INSTANCE_TYPE=gmi.sandbox.small
# Optional reusable, already-built template. Must have no credentials or mounted data.
GMI_AGENT_SLUG=
CLOUDVET_IMAGE=docker.io/library/python:3.12-bookworm
GMI_TRIAGE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
GMI_FIX_MODEL=anthropic/claude-sonnet-4.5
CLOUDVET_TIMEOUT_SECONDS=300
CLOUDVET_COMMAND_TIMEOUT=120
